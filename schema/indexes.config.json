{
  "legacy_drop_indexes": [
    "_openid_1",
    "_owner_openid_1",
    "_member_openid_1",
    "_creator_openid_1"
  ],
  "legacy_drop_by_collection": {
    "users": ["_openid_1"],
    "sms_codes": ["phone", "request_openid"],
    "students": ["owner_user_id", "owner_openid"],
    "schedules": ["owner_user_id", "owner_openid", "shared_with.openid"],
    "courses": ["schedule_id", "owner_openid", "student_id"],
    "families": ["owner_user_id", "member_user_id", "owner_openid", "member_openid"],
    "share_codes": ["code"],
    "reminders": ["openid", "user_id"],
    "course_name_presets": ["openid", "user_id"],
    "tools_data": ["openid", "user_id"]
  },
  "legacy_only_collections": ["tools_data"],
  "collections": [
    {
      "name": "users",
      "indexes": [
        { "name": "phone", "unique": true, "keys": [{ "name": "phone", "direction": "1" }] },
        { "name": "openid", "unique": true, "keys": [{ "name": "openid", "direction": "1" }] }
      ]
    },
    {
      "name": "sms_codes",
      "indexes": [
        {
          "name": "phone_status_expires_at",
          "unique": false,
          "keys": [
            { "name": "phone", "direction": "1" },
            { "name": "status", "direction": "1" },
            { "name": "expires_at", "direction": "-1" }
          ]
        },
        {
          "name": "phone_createTime",
          "unique": false,
          "keys": [
            { "name": "phone", "direction": "1" },
            { "name": "createTime", "direction": "-1" }
          ]
        },
        {
          "name": "request_openid_createTime",
          "unique": false,
          "keys": [
            { "name": "request_openid", "direction": "1" },
            { "name": "createTime", "direction": "-1" }
          ]
        },
        {
          "name": "status_expires_at",
          "unique": false,
          "keys": [
            { "name": "status", "direction": "1" },
            { "name": "expires_at", "direction": "1" }
          ]
        }
      ]
    },
    {
      "name": "students",
      "indexes": [
        {
          "name": "owner_createTime",
          "unique": false,
          "keys": [
            { "name": "owner_user_id", "direction": "1" },
            { "name": "createTime", "direction": "-1" }
          ]
        },
        {
          "name": "owner_source",
          "unique": false,
          "keys": [
            { "name": "owner_user_id", "direction": "1" },
            { "name": "source", "direction": "1" }
          ]
        }
      ]
    },
    {
      "name": "schedules",
      "indexes": [
        { "name": "invite_code", "unique": true, "keys": [{ "name": "invite_code", "direction": "1" }] },
        {
          "name": "owner_createTime",
          "unique": false,
          "keys": [
            { "name": "owner_user_id", "direction": "1" },
            { "name": "createTime", "direction": "-1" }
          ]
        },
        { "name": "student_id", "unique": false, "keys": [{ "name": "student_id", "direction": "1" }] },
        {
          "name": "shared_user",
          "unique": false,
          "keys": [{ "name": "shared_with.user_id", "direction": "1" }]
        }
      ]
    },
    {
      "name": "courses",
      "indexes": [
        {
          "name": "schedule_day_slot",
          "unique": false,
          "keys": [
            { "name": "schedule_id", "direction": "1" },
            { "name": "day_of_week", "direction": "1" },
            { "name": "slot", "direction": "1" }
          ]
        },
        { "name": "day_of_week", "unique": false, "keys": [{ "name": "day_of_week", "direction": "1" }] }
      ]
    },
    {
      "name": "families",
      "indexes": [
        {
          "name": "owner_member",
          "unique": true,
          "keys": [
            { "name": "owner_user_id", "direction": "1" },
            { "name": "member_user_id", "direction": "1" }
          ]
        },
        { "name": "member_user_id", "unique": false, "keys": [{ "name": "member_user_id", "direction": "1" }] }
      ]
    },
    {
      "name": "share_codes",
      "indexes": [
        { "name": "code", "unique": true, "keys": [{ "name": "code", "direction": "1" }] },
        {
          "name": "schedule_type",
          "unique": false,
          "keys": [
            { "name": "schedule_id", "direction": "1" },
            { "name": "type", "direction": "1" }
          ]
        }
      ]
    },
    {
      "name": "reminders",
      "indexes": [
        {
          "name": "status_trigger_time",
          "unique": false,
          "keys": [
            { "name": "status", "direction": "1" },
            { "name": "trigger_time", "direction": "1" }
          ]
        },
        { "name": "schedule_id", "unique": false, "keys": [{ "name": "schedule_id", "direction": "1" }] },
        { "name": "course_id", "unique": false, "keys": [{ "name": "course_id", "direction": "1" }] }
      ]
    },
    {
      "name": "course_name_presets",
      "indexes": [
        {
          "name": "user_created_at",
          "unique": false,
          "keys": [
            { "name": "user_id", "direction": "1" },
            { "name": "created_at", "direction": "-1" }
          ]
        },
        {
          "name": "user_grade_name",
          "unique": true,
          "keys": [
            { "name": "user_id", "direction": "1" },
            { "name": "grade_level", "direction": "1" },
            { "name": "name", "direction": "1" }
          ]
        }
      ]
    }
  ]
}
